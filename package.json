{
  "name": "vscode-ctrmml",
  "displayName": "ctrmml",
  "description": "Language support for ctrmml",
  "version": "0.1.9",
  "publisher": "ulalume",
  "repository": {
    "type": "git",
    "url": "https://github.com/ulalume/vscode-ctrmml.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ctrmml",
    "onCommand:ctrmml.play",
    "onCommand:ctrmml.playFromCursor",
    "onCommand:ctrmml.stop",
    "onCommand:ctrmml.mdslinkFile",
    "onCommand:ctrmml.mdslinkDirectory",
    "onCommand:ctrmml.mdslinkFromConfig",
    "onCommand:ctrmml.mdslinkMenu",
    "onCommand:ctrmml.quickromFile",
    "onCommand:ctrmml.quickromDirectory",
    "onCommand:ctrmml.quickromFromConfig",
    "onCommand:ctrmml.quickromMenu",
    "onCommand:ctrmml.exportVgm",
    "onCommand:ctrmml.exportWav",
    "onCommand:mml.previewPatch",
    "onCommand:mml.loadPatch",
    "onCommand:mml.savePatch"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ctrmml.play",
        "title": "ctrmml: play"
      },
      {
        "command": "ctrmml.playFromCursor",
        "title": "ctrmml: play from cursor"
      },
      {
        "command": "ctrmml.stop",
        "title": "ctrmml: stop"
      },
      {
        "command": "ctrmml.mdslinkFile",
        "title": "ctrmml: mdslink file"
      },
      {
        "command": "ctrmml.mdslinkDirectory",
        "title": "ctrmml: mdslink directory"
      },
      {
        "command": "ctrmml.mdslinkFromConfig",
        "title": "ctrmml: mdslink from mdslink.json"
      },
      {
        "command": "ctrmml.mdslinkMenu",
        "title": "ctrmml: mdslink..."
      },
      {
        "command": "ctrmml.quickromFile",
        "title": "ctrmml: quickrom file"
      },
      {
        "command": "ctrmml.quickromDirectory",
        "title": "ctrmml: quickrom directory"
      },
      {
        "command": "ctrmml.quickromFromConfig",
        "title": "ctrmml: quickrom from quickrom.json"
      },
      {
        "command": "ctrmml.quickromMenu",
        "title": "ctrmml: quickrom..."
      },
      {
        "command": "ctrmml.exportVgm",
        "title": "ctrmml: export vgm"
      },
      {
        "command": "ctrmml.exportWav",
        "title": "ctrmml: export wav"
      }
    ],
    "keybindings": [
      {
        "command": "ctrmml.play",
        "key": "ctrl+alt+shift+p",
        "mac": "cmd+alt+shift+p",
        "when": "editorTextFocus && editorLangId == ctrmml"
      },
      {
        "command": "ctrmml.playFromCursor",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "editorTextFocus && editorLangId == ctrmml"
      },
      {
        "command": "ctrmml.stop",
        "key": "ctrl+alt+.",
        "mac": "cmd+alt+.",
        "when": "editorTextFocus && editorLangId == ctrmml"
      }
    ],
    "languages": [
      {
        "id": "ctrmml",
        "aliases": [
          "ctrmml",
          "MML"
        ],
        "extensions": [
          ".mml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "ctrmml",
      "properties": {
        "ctrmml.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Path to ctrmml-lsp binary. If empty, the extension downloads it automatically."
        },
        "ctrmml.languageServer.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Command-line arguments passed to ctrmml-lsp."
        },
        "ctrmml.languageServer.env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Extra environment variables passed to ctrmml-lsp."
        },
        "ctrmml.languageServer.initializationOptions": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "Initialization options for ctrmml-lsp."
        },
        "ctrmml.completion.arpeggio.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable arpeggio (broken-chord) completions when typing a note letter on a track line. Applied when the language server starts; reload the window after changing."
        },
        "ctrmml.completion.arpeggio.pattern": {
          "type": "string",
          "enum": ["up", "down", "updown", "downup", "alberti"],
          "enumDescriptions": [
            "Root to top.",
            "Top to root.",
            "Up, then back down.",
            "Down, then back up.",
            "Alberti bass figure (low, high, middle, high)."
          ],
          "default": "up",
          "markdownDescription": "Traversal pattern for arpeggio completions. Only used when `#ctrmml.completion.arpeggio.enabled#` is on. Applied when the language server starts; reload the window after changing."
        },
        "ctrmml.completion.chordStackMode": {
          "type": "string",
          "enum": ["stack_up", "plain"],
          "enumDescriptions": [
            "Stack chord tones upward from the root, inserting octave marks as needed (e.g. `f/a/>c`).",
            "Close voicing at the channel octave with no octave marks (e.g. `f/a/c`) — the behavior before language server v0.6.8."
          ],
          "default": "stack_up",
          "markdownDescription": "How chord and dyad completion bodies are voiced. Applied when the language server starts; reload the window after changing."
        },
        "ctrmml.completion.fmPickerHierarchy": {
          "type": "string",
          "enum": ["auto", "on", "off"],
          "enumDescriptions": [
            "Let the server decide from the connecting editor — VS Code gets the two-step picker.",
            "Two-step picker: choose an instrument file, then a patch inside it.",
            "Flat list with one completion item per patch, labeled by relative path."
          ],
          "default": "auto",
          "markdownDescription": "Style of the FM instrument picker offered on `@N fm` lines. Applied when the language server starts; reload the window after changing."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=out/extension.js --sourcemap --minify --legal-comments=none --external:vscode && node scripts/copy-web-tree-sitter-wasm.js",
    "watch": "node scripts/copy-web-tree-sitter-wasm.js && esbuild src/extension.ts --bundle --platform=node --target=node18 --format=cjs --outfile=out/extension.js --sourcemap --external:vscode --watch",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.12",
    "tar": "^7.5.9",
    "vscode-languageclient": "^9.0.1",
    "web-tree-sitter": "^0.26.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.11.30",
    "@types/tar": "^6.1.10",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.3.3"
  }
}
